DATABASE_URL=postgres://oa:oa@localhost:5432/oa
REDIS_URL=redis://localhost:6379

# Entra ID app (Graph crawler, app-only) and API token validation
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Application ID URI from "Expose an API", normally api://<AZURE_CLIENT_ID>
API_AUDIENCE=api://<AZURE_CLIENT_ID>

# Embeddings
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Public base URL used for Graph webhook subscriptions
PUBLIC_BASE_URL=

# Local folder sources: allowed roots, separated by ";"
LOCAL_SOURCE_ROOTS=
# Where screenshots are stored (absolute path so API and worker share it)
BLOB_DIR=
# Local development only: accept any bearer token as a user with these roles
AUTH_DEV_ROLES=

# Claude (routing, answers, grounding verifier, screenshot descriptions, video storyboards)
ANTHROPIC_API_KEY=
# Optional: Azure AI Speech for video voice-over. Without it videos use on-screen captions.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Only show documents a user can open (needs document ACLs and a "groups" claim in tokens)
ACL_TRIMMING=false
