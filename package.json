{
  "name": "onboarding-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run build -w @oa/web",
    "test": "vitest run",
    "db:generate": "npm run generate -w @oa/db",
    "db:migrate": "npm run migrate -w @oa/db",
    "dev:api": "npm run dev -w @oa/api",
    "dev:worker": "npm run dev -w @oa/worker",
    "dev:web": "npm run dev -w @oa/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^24.0.0",
    "docx": "^9.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
